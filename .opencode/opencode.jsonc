{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "protocol": "legacy"
      },
      "github-readonly": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/readonly",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
          "X-MCP-Readonly": "true",
          "X-MCP-Toolsets": "repos,pull_requests,actions,code_security",
          "X-MCP-Lockdown": "true"
        },
        "protocol": "legacy"
      }
    }
  }
}
