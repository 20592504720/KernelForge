{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelforge.invalid/schemas/patch-manifest.schema.json",
  "title": "KernelForge patch manifest",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kernel", "patches"],
  "properties": {
    "schema_version": { "const": 1 },
    "kernel": { "enum": ["common", "5.10", "5.15", "6.1", "6.6", "6.12"] },
    "patches": { "type": "array", "items": { "type": "object", "additionalProperties": false,
      "required": ["id", "file", "sha256", "source", "enabled"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "file": { "type": "string", "pattern": "^[^/].*\\.patch$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source": { "type": "string", "format": "uri" },
        "enabled": { "type": "boolean" },
        "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "order": { "type": "integer", "minimum": 0 }
      }
    }}
  }
}
