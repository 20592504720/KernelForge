    "id",
    "android_gki",
    "kernel_version",
    "kernel_commit",
    "susfs_commit",
    "provider_commits",
    "upstream_patch_sha256",
    "file",
    "sha256",
    "reason",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "android_gki": {
      "type": "string"
    },
    "kernel_version": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "file": {
      "type": "string"
    },
    "kernel_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "susfs_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "upstream_patch_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256": {
