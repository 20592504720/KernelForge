{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelforge.invalid/schemas/kernel.schema.json",
  "title": "Kernel family configuration",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kernel", "architectures", "toolchain", "build", "features"],
  "properties": {
    "schema_version": { "const": 1 },
    "kernel": { "enum": ["5.10", "5.15", "6.1", "6.6", "6.12"] },
    "architectures": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["aarch64", "x86_64"] } },
    "toolchain": { "type": "object", "additionalProperties": false, "required": ["family", "version_policy"], "properties": { "family": { "enum": ["clang", "gcc", "per-device"] }, "version_policy": { "type": "string", "minLength": 1 } } },
    "build": { "type": "object", "additionalProperties": false, "required": ["default_mode", "make_args"], "properties": { "default_mode": { "enum": ["gki", "vendor"] }, "make_args": { "type": "array", "items": { "type": "string" } } } },
    "features": { "type": "object", "additionalProperties": false, "required": ["kernelsu_variants", "patch_manifest"], "properties": { "kernelsu_variants": { "type": "array", "uniqueItems": true, "items": { "enum": ["official", "next", "resukisu"] } }, "patch_manifest": { "type": "string", "pattern": "^patches/[^/]+/manifest\\.json$" } } }
  }
}
