{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schema_version","source","build","toolchain","artifacts"],
  "properties":{
    "schema_version":{"const":1},
    "source":{"type":"object","additionalProperties":false,"required":["repository","ref"],"properties":{"repository":{"type":"string","format":"uri"},"ref":{"type":"string","minLength":1}}},
    "defconfig":{"type":"string"},
    "environment":{"type":"object","additionalProperties":{"type":"string"},"propertyNames":{"pattern":"^[A-Z_][A-Z0-9_]*$"}},
    "toolchain":{"type":"object","additionalProperties":false,"required":["required"],"properties":{"required":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["name"],"properties":{"name":{"type":"string","minLength":1},"minimum":{"type":"string","pattern":"^\\d+(?:\\.\\d+)*$"}}}}}},
    "build":{"type":"object","additionalProperties":false,"required":["mode","jobs","gki","vendor"],"properties":{"mode":{"enum":["gki","vendor"]},"jobs":{"type":"integer","minimum":1},"gki":{"type":"object","additionalProperties":false,"required":["system","argv"],"properties":{"system":{"enum":["kleaf","build-sh"]},"argv":{"type":"array","minItems":1,"items":{"type":"string"}}}},"vendor":{"type":"object","additionalProperties":false,"required":["argv"],"properties":{"argv":{"type":"array","minItems":1,"items":{"type":"string"}}}}}},
    "artifacts":{"type":"object","additionalProperties":false,"required":["paths"],"properties":{"paths":{"type":"array","items":{"type":"string","minLength":1}},"require_at_least_one":{"type":"boolean","default":true}}}
  }
}
