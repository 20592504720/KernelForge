{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "build",
    "toolchain",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "patch_series": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "feature": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kernel_commits": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "upstream": {
            "type": "string",
            "pattern": "^https://"
          },
          "upstream_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "kernel_versions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "5.10",
                "5.15",
                "6.1",
                "6.6",
                "6.12"
              ]
            }
          },
          "android_gki": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "architectures": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "arm64",
                "arm",
                "x86_64"
              ]
            }
          },
          "build_modes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "gki",
                "vendor"
              ]
            }
          },
          "required_configs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9_]+$"
            }
          },
          "adaptation": {
            "enum": [
              "git-apply-text-v1"
            ]
          },
          "verification": {
            "enum": [
              "TESTED",
              "UNTESTED"
            ]
          },
          "source_spec": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "version_policy"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "pattern": "^https://"
              },
              "version_policy": {
                "enum": [
                  "pinned",
                  "latest_release",
                  "latest_prerelease",
                  "latest_branch"
                ]
              },
              "ref_type": {
                "enum": [
                  "commit",
                  "tag",
                  "branch"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "branch": {
                "type": "string",
                "minLength": 1
              },
              "expected_commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "version_policy": {
                      "const": "pinned"
                    }
                  }
                },
                "then": {
                  "required": [
                    "ref_type",
                    "ref",
                    "expected_commit"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "version_policy": {
                      "const": "latest_branch"
                    }
                  }
                },
                "then": {
                  "required": [
                    "branch"
                  ]
                }
              }
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "order": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "feature",
          "file",
          "kernel_commits",
          "upstream",
          "license"
        ],
        "allOf": [
          {
            "if": {
              "not": {
                "required": [
                  "source_spec"
                ]
              }
            },
            "then": {
              "required": [
                "sha256",
                "upstream_commit"
              ]
            }
          }
        ]
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "device_profile": {
      "enum": [
        "oneplus13-pjz110",
        "oneplus-ace6-plq110"
      ]
    },
    "kernel_version": {
      "enum": [
        "5.10",
        "5.15",
        "6.1",
        "6.6",
        "6.12"
      ]
    },
    "defconfig": {
      "type": "string"
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "pattern": "^[A-Z_][A-Z0-9_]*$"
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "minimum": {
                "type": "string",
                "pattern": "^\\d+(?:\\.\\d+)*$"
              }
            }
          }
        },
        "mode": {
          "enum": [
            "AUTO",
            "LOCAL_ONLY",
            "DOWNLOAD_ONLY"
          ]
        },
        "cache_dir": {
          "type": "string",
          "minLength": 1
        },
        "lock_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "jobs",
        "gki",
        "vendor"
      ],
      "properties": {
        "mode": {
          "enum": [
            "gki",
            "vendor"
          ]
        },
        "jobs": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "gki": {
          "$ref": "#/$defs/adapter"
        },
        "vendor": {
          "$ref": "#/$defs/adapter"
        },
        "ccache": {
          "$ref": "#/$defs/ccachePolicy"
        },
        "build_timestamp": {
          "type": "string",
          "description": "Optional explicit kernel build time with timezone; blank/omitted means current UTC at build start.",
          "pattern": "^(?:|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:Z|[+-][0-9]{2}:[0-9]{2}))$",
          "default": ""
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "require_at_least_one": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "kernelsu": {
      "$ref": "#/$defs/kernelsu"
    },
    "susfs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "repository": {
          "const": "https://gitlab.com/simonpunk/susfs4ksu.git"
        },
        "version_policy": {
          "enum": [
            "pinned",
            "latest_branch"
          ]
        },
        "ref_type": {
          "const": "commit"
        },
        "ref": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "expected_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "branch": {
          "type": "string"
        },
        "android_gki": {
          "enum": [
            "android12-5.10",
            "android13-5.15",
            "android14-6.1",
            "android15-6.6",
            "android16-6.12"
          ]
        },
        "allow_bakasu_inline": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "repository",
              "version_policy",
              "android_gki"
            ],
            "if": {
              "properties": {
                "version_policy": {
                  "const": "pinned"
                }
              }
            },
            "then": {
              "required": [
                "ref",
                "expected_commit"
              ]
            }
          }
        }
      ]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kconfig",
        "kbuild"
      ],
      "properties": {
        "kconfig": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "kbuild": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7200
        },
        "final_config": {
          "type": "string"
        },
        "required_configs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          }
        }
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "minimum": {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d+)*$"
        },
        "version_args": {
          "type": "string"
        }
      }
    },
    "toolchainProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "target_arch",
        "executables"
      ],
      "properties": {
        "kind": {
          "enum": [
            "llvm",
            "gcc"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d+)*$"
        },
        "minimum_version": {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d+)*$"
        },
        "maximum_version": {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d+)*$"
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "host_arch": {
          "type": "string",
          "minLength": 1
        },
        "target_arch": {
          "type": "string",
          "minLength": 1
        },
        "local_path": {
          "type": "string",
          "minLength": 1
        },
        "local_root": {
          "type": "string",
          "minLength": 1
        },
        "trust_source": {
          "type": "string",
          "minLength": 1
        },
        "cache_dir": {
          "type": "string",
          "minLength": 1
        },
        "download_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "version_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300
        },
        "lock_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "expected_size": {
          "type": "integer",
          "minimum": 1
        },
        "archive_format": {
          "enum": [
            "zip",
            "tar",
            "tar.gz",
            "tgz",
            "tar.xz",
            "tar.bz2"
          ]
        },
        "layout_root": {
          "type": "string"
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "version_executable": {
          "type": "string",
          "minLength": 1
        },
        "version_args": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "string"
            }
          ]
        },
        "target_query_args": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "string"
            }
          ]
        },
        "executables": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "cross_compile": {
          "type": "string"
        },
        "environment": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "release_lock": {
          "$ref": "#/$defs/reviewedReleaseLock"
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "local_path"
                ]
              },
              {
                "required": [
                  "local_root"
                ]
              }
            ]
          },
          "then": {},
          "else": {
            "required": [
              "source_type",
              "url",
              "sha256"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "source_type": {
                      "enum": [
                        "archive",
                        "llvm-release",
                        "gcc-release"
                      ]
                    }
                  },
                  "required": [
                    "source_type"
                  ]
                },
                "then": {
                  "required": [
                    "archive_format"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source_type": {
                "enum": [
                  "llvm-release",
                  "gcc-release",
                  "reviewed-github-release"
                ]
              }
            },
            "required": [
              "source_type"
            ]
          },
          "then": {
            "required": [
              "release_lock"
            ]
          }
        }
      ]
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv"
      ],
      "properties": {
        "system": {
          "enum": [
            "kleaf",
            "build-sh"
          ]
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "directory": {
          "type": "string"
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool"
          }
        },
        "toolchain_profile": {
          "$ref": "#/$defs/toolchainProfile"
        }
      }
    },
    "kernelsu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "provider": {
          "enum": [
            "official",
            "derived",
            "bakssu",
            "bakasu"
          ]
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "upstream": {
          "const": "https://github.com/tiann/KernelSU.git"
        },
        "ref_type": {
          "enum": [
            "stable",
            "commit",
            "tag",
            "branch"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "expected_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "method": {
          "enum": [
            "builtin-link-v1",
            "builtin-kbuild-v2"
          ]
        },
        "architecture": {
          "const": "arm64"
        },
        "kernel_directory": {
          "type": "string",
          "minLength": 1
        },
        "config_file": {
          "type": "string",
          "minLength": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kernel_families",
            "build_modes",
            "required_configs"
          ],
          "properties": {
            "kernel_families": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "5.10",
                  "5.15",
                  "6.1",
                  "6.6",
                  "6.12"
                ]
              }
            },
            "build_modes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "gki",
                  "vendor"
                ]
              }
            },
            "required_configs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Z0-9_]+$"
              }
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "upstream_evidence",
            "setup_sha256"
          ],
          "properties": {
            "upstream_evidence": {
              "type": "string",
              "minLength": 1
            },
            "setup_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "version_policy": {
          "enum": [
            "pinned",
            "latest_release",
            "latest_prerelease",
            "latest_branch"
          ]
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "provider",
              "project",
              "repository",
              "upstream",
              "method",
              "architecture",
              "config_file",
              "compatibility"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "if": {
              "properties": {
                "version_policy": {
                  "enum": [
                    "latest_release",
                    "latest_prerelease",
                    "latest_branch"
                  ]
                }
              },
              "required": [
                "version_policy"
              ]
            },
            "then": {},
            "else": {
              "required": [
                "ref",
                "ref_type",
                "expected_commit"
              ]
            }
          }
        }
      ]
    },
    "reviewedReleaseLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "release_id",
        "asset_id",
        "tag",
        "asset_name",
        "asset_size",
        "uploader_id",
        "sha256",
        "license",
        "license_reviewed"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "release_id": {
          "type": "integer",
          "minimum": 1
        },
        "asset_id": {
          "type": "integer",
          "minimum": 1
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
        },
        "asset_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,254}$"
        },
        "asset_size": {
          "type": "integer",
          "minimum": 1
        },
        "uploader_id": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "license": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "license_reviewed": {
          "const": true
        },
        "require_immutable": {
          "type": "boolean"
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "sha256",
            "source_commit",
            "repository"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "source_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "repository": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        }
      }
    },
    "ccachePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "max_size_mib": {
          "type": "integer",
          "minimum": 64,
          "maximum": 8192
        },
        "lock_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300
        }
      }
    }
  }
}
