{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schema_version","source","build","toolchain","artifacts"],
  "properties":{
    "schema_version":{"const":1},
    "source":{"type":"object","additionalProperties":false,"required":["repository","ref"],"properties":{"repository":{"type":"string","format":"uri"},"ref":{"type":"string","minLength":1},"timeout_seconds":{"type":"integer","minimum":1,"maximum":3600}}},
    "device":{"type":"object","additionalProperties":false,"required":["id"],"properties":{"id":{"type":"string","minLength":1}}},
    "kernel_version":{"enum":["5.10","5.15","6.1","6.6","6.12"]},
    "defconfig":{"type":"string"},
    "environment":{"type":"object","additionalProperties":{"type":"string"},"propertyNames":{"pattern":"^[A-Z_][A-Z0-9_]*$"}},
    "toolchain":{"type":"object","additionalProperties":false,"required":["required"],"properties":{"required":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["name"],"properties":{"name":{"type":"string","minLength":1},"minimum":{"type":"string","pattern":"^\\d+(?:\\.\\d+)*$"}}}}}},
    "build":{"type":"object","additionalProperties":false,"required":["mode","jobs","gki","vendor"],"properties":{"mode":{"enum":["gki","vendor"]},"jobs":{"type":"integer","minimum":1},"timeout_seconds":{"type":"integer","minimum":1,"maximum":86400},"gki":{"$ref":"#/$defs/adapter"},"vendor":{"$ref":"#/$defs/adapter"}}},
    "artifacts":{"type":"object","additionalProperties":false,"required":["paths"],"properties":{"paths":{"type":"array","items":{"type":"string","minLength":1}},"require_at_least_one":{"type":"boolean","default":true}}}
  },
  "$defs":{"tool":{"type":"object","additionalProperties":false,"required":["name"],"properties":{"name":{"type":"string","minLength":1},"path":{"type":"string"},"minimum":{"type":"string","pattern":"^\\d+(?:\\.\\d+)*$"},"version_args":{"type":"string"}}},"adapter":{"type":"object","additionalProperties":false,"required":["argv"],"properties":{"system":{"enum":["kleaf","build-sh"]},"argv":{"type":"array","minItems":1,"items":{"type":"string"}},"directory":{"type":"string"},"environment":{"type":"object","additionalProperties":{"type":"string"},"propertyNames":{"pattern":"^[A-Z_][A-Z0-9_]*$"}},"targets":{"type":"array","items":{"type":"string"}},"artifacts":{"type":"array","items":{"type":"string"}},"required_tools":{"type":"array","items":{"$ref":"#/$defs/tool"}}}}}
}
